# Copy to .env and fill in. The real .env is gitignored — never commit it.
#
# NOTE: Docker's --env-file does NOT strip inline comments, so every comment here is on
# its own line. Don't put a "# comment" after a VALUE on the same line, or Docker will
# read it as part of the value.

# --- Required secrets ---
# OpenAI API key for the chat model
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Pinecone API key (free tier is fine)
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Vector store (defaults match the index my ingestion script creates) ---
# name of the Pinecone index to query
PINECONE_INDEX=iphone-user-guide
# serverless cloud provider
PINECONE_CLOUD=aws
# serverless region (free tier)
PINECONE_REGION=us-east-1

# --- Models ---
# Must remain this model/dimension unless the Pinecone index is re-ingested. The Docker
# image pre-downloads this exact model, so an incompatible runtime override is rejected.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# must match the pre-ingested index dimension
EMBEDDING_DIM=384
# OpenAI chat model (exact id)
OPENAI_CHAT_MODEL=gpt-6-luna
# Includes visible output and reasoning tokens. Raise this if a model reports a
# length finish reason before returning a response.
OPENAI_MAX_COMPLETION_TOKENS=2048
# GPT-6 Luna supports low, medium, high, xhigh, max, and none.
OPENAI_REASONING_EFFORT=low

# --- Ingestion (only used by ingest.py, not at run time) ---
# source document to ingest
PDF_PATH=iPhone User Guide 1.pdf
# characters per chunk
CHUNK_SIZE=800
# character overlap between chunks
CHUNK_OVERLAP=120

# --- Retrieval / generation (optional) ---
# chunks retrieved per question
TOP_K=5
# below this best-match score, the bot says it's not in the guide
MIN_RELEVANCE_SCORE=0.55
# maximum accepted user-message length; longer input is safely rejected
MAX_QUESTION_CHARS=4000
# recent conversation messages used only to resolve follow-up references
MAX_HISTORY_MESSAGES=12
# false by default; when true, emits local structured RAG-stage diagnostics without secrets
ENABLE_RAG_DIAGNOSTICS=false

# --- UI ---
# port the Chainlit app listens on
PORT=8000
# seconds between streamed characters; increase for a slower typing effect
STREAM_CHAR_DELAY=0.018
