# Copy to .env and fill in. The real .env is gitignored — never commit it.

# --- Required secrets ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx   # Anthropic API key for the chat model
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxx      # Pinecone API key (free tier is fine)

# --- Vector store (defaults match the index my ingestion script creates) ---
PINECONE_INDEX=iphone-user-guide                   # name of the Pinecone index to query
PINECONE_CLOUD=aws                                 # serverless cloud provider
PINECONE_REGION=us-east-1                           # serverless region (free tier)

# --- Models (optional overrides; documented defaults shown) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5             # open 384-dim embedding model, runs in-container
EMBEDDING_DIM=384                                   # must match the index dimension
CHAT_MODEL=claude-opus-4-8                          # Anthropic chat model (exact id)

# --- Ingestion (only used by ingest.py, not at run time) ---
PDF_PATH=iPhone User Guide 1.pdf                    # source document to ingest
CHUNK_SIZE=800                                       # characters per chunk
CHUNK_OVERLAP=120                                    # character overlap between chunks

# --- Retrieval / generation (optional) ---
TOP_K=5                                              # chunks retrieved per question
MIN_RELEVANCE_SCORE=0.55                             # below this best-match score, the bot says it's not in the guide

# --- UI ---
PORT=8000                                           # port the Chainlit app listens on
